#!/usr/bin/env python3
"""fwbuilder2cdist - convert a fwbuilder project to cdist __firewall rules + db.

Usage:
    fwbuilder2cdist --fwb firewall.fwb --firewall Sheppard [--outdir out/]
                     [--output-name sheppard.cnw.verboom.net]
                     [--existing-db path/db [--apply-db] [--batch]]
                     [--policy accept|drop] [--proto 4|6|4,6]
                     [--established true|false] [--icmp true|false]

Reads a fwbuilder project (XML) and emits, for the named firewall:
    <output-name>.rules   - cdist __firewall rules file
    <output-name>.db      - cdist __firewall database file

With --existing-db, the generated entries are reconciled against the shared
cdist db instead of being emitted as a standalone db: entries already present
(exact match) are reused, unambiguous value matches are auto-mapped to the
existing name, and ambiguous cases (same name different value, or several
value matches) are resolved interactively (or automatically with --batch).
The rules file is rewritten to use the mapped names and the genuinely new
entries are written to <output-name>.new.db (or appended to the existing db
with --apply-db).

The generated rules are flat: fwbuilder's user chains/jumps are gone by
construction (rules are read from the logical Policy/NAT rules, not from
generated iptables). Deliberate simplifications (reported as warnings):

* Interface restrictions are only kept when the rule group name matches a
  firewall interface name (e.g. group "Openvpn" -> -i/-o openvpn); a direct
  reference to a firewall Interface in a rule's Src/Dst is resolved to the
  network(s) that interface serves.
* Inbound rules to the firewall itself do not get -d <firewall ip>.
* The final "deny all, log" rule becomes policy=drop + log= in [global].
* Loopback rules are converted as normal rules and the implicit loopback
  global is disabled.
* DNAT rules use the rule's own public destination IP when present, else the
  first public firewall IP.
* SNAT rules use the fwbuilder translate-to (TSrc) address when present, else
  a LAN/public heuristic.
* mangle rules are not converted (a warning is emitted).
"""

import argparse
import ipaddress
import os
import re
import shutil
import sys
import xml.etree.ElementTree as ET

NS = '{http://www.fwbuilder.org/1.0/}'

# icmpv4 type -> icmpv6 type (best effort, falls back to the same number)
ICMPV6 = {8: 128, 0: 129, 3: 1, 4: 2, 5: 137, 11: 3, 12: 4,
          13: 130, 14: 131, 17: 134, 18: 135, 9: 138, 10: 139}


def cidr(addr, netmask):
    try:
        return str(ipaddress.ip_network('%s/%s' % (addr, netmask), strict=False))
    except ValueError:
        return '%s/%s' % (addr, netmask)


class ServiceRegistry:
    """Collects services and assigns db names, handling tcp/udp name
    collisions the same way as the existing cdist db (udp keeps the name,
    tcp gets a _tcp suffix)."""

    def __init__(self):
        self.ports = {}   # (name, proto) -> port
        self.icmp = {}    # name -> type
        self.dbname = {}  # (name, proto) -> db name

    def add_port(self, name, proto, port):
        self.ports[(name, proto)] = port

    def add_icmp(self, name, typ):
        self.icmp[name] = typ

    def finalize(self):
        byname = {}
        for (name, proto) in self.ports:
            byname.setdefault(name, set()).add(proto)
        for name, protos in byname.items():
            if len(protos) == 1:
                self.dbname[(name, next(iter(protos)))] = name
            else:
                self.dbname[(name, 'udp')] = name
                self.dbname[(name, 'tcp')] = '%s_tcp' % name

    def db(self):
        d = {}
        for (name, proto), port in self.ports.items():
            d[self.dbname[(name, proto)]] = '%s/%s' % (port, proto)
        for name, typ in self.icmp.items():
            d[name] = 'icmp/%s' % typ if typ != '-1' else 'icmp'
        return d


class Converter:
    def __init__(self, fwb, fw_name, policy='drop', proto='4,6',
                 established=True, icmp=None):
        self.tree = ET.parse(fwb)
        self.root = self.tree.getroot()
        self.objects = {el.get('id'): el for el in self.root.iter() if el.get('id')}
        self.fw = self._find_firewall(fw_name)
        if self.fw is None:
            sys.exit("error: firewall '%s' not found in project" % fw_name)
        self.fw_name = fw_name
        self.policy = policy
        self.proto = proto
        self.established = established
        self.icmp = icmp
        self.fw_ifaces = self._fw_interfaces()   # {name: [(ip, netmask), ...]}
        self.lan_subnets = self._lan_subnets()
        self.host_ips = {}   # host name -> [ip, ...]
        self.svc = ServiceRegistry()
        self.db = {k: {} for k in ('services', 'hosts', 'networks',
                                   'hostgroups', 'networkgroups', 'servicegroups')}
        self.rules = []      # (table, line, section)
        self.nat = []        # ('nat', line, section)
        self.warnings = []
        self._warned_groups = set()
        self._warned_both = set()
        self.loopback_rules = False
        self.log_global = False

    # ---------- object helpers ----------

    def _find_firewall(self, name):
        for f in self.root.iter(NS + 'Firewall'):
            if f.get('name') == name:
                return f
        return None

    def _obj(self, ref):
        return self.objects.get(ref)

    def _name(self, ref):
        o = self._obj(ref)
        if o is None:
            self.warnings.append('missing object %s' % ref)
            return '<missing %s>' % ref
        return o.get('name')

    def _fw_interfaces(self):
        res = {}
        for itf in self.fw.iter(NS + 'Interface'):
            ips = []
            for addr in itf:
                if addr.tag in (NS + 'IPv4', NS + 'IPv6'):
                    ips.append((addr.get('address'), addr.get('netmask')))
            res[itf.get('name')] = ips
        return res

    def _fw_ips(self):
        return [ip for ips in self.fw_ifaces.values() for ip, _ in ips]

    def _iface_is_wan(self, name):
        # an interface is WAN if it has a public IPv4 address (a public IPv6
        # on a LAN interface is just a routed subnet)
        for ip, _ in self.fw_ifaces.get(name, []):
            try:
                a = ipaddress.ip_address(ip)
                if a.version == 4 and not a.is_private:
                    return True
            except ValueError:
                pass
        return False

    def _lan_subnets(self):
        """networks served by non-WAN interfaces (the LAN side)."""
        res = []
        for name, ips in self.fw_ifaces.items():
            if self._iface_is_wan(name):
                continue
            for ip, mask in ips:
                try:
                    res.append(ipaddress.ip_network('%s/%s' % (ip, mask), strict=False))
                except ValueError:
                    pass
        return res

    def _fw_public_ip(self):
        for ip in self._fw_ips():
            try:
                if not ipaddress.ip_address(ip).is_private:
                    return ip
            except ValueError:
                pass
        return self._fw_ips()[0] if self._fw_ips() else None

    def _fw_private_ip(self):
        for ip in self._fw_ips():
            try:
                a = ipaddress.ip_address(ip)
                if a.is_private and not a.is_link_local and a.version == 4:
                    return ip
            except ValueError:
                pass
        return None

    def _host_ips(self, host_el):
        ips = []
        for itf in host_el.iter(NS + 'Interface'):
            for addr in itf:
                if addr.tag in (NS + 'IPv4', NS + 'IPv6'):
                    ips.append(addr.get('address'))
        return ips

    def _is_fw_ip(self, ip):
        return ip in self._fw_ips()

    def _ip_in_lan(self, ip):
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            return False
        for net in self.lan_subnets:
            if a in net:
                return True
        return False

    def _net_in_lan(self, net):
        try:
            n = ipaddress.ip_network(net, strict=False)
        except ValueError:
            return False
        for lan in self.lan_subnets:
            if n.overlaps(lan):
                return True
        return False

    def _net_has_fw_ip(self, net):
        try:
            n = ipaddress.ip_network(net, strict=False)
        except ValueError:
            return False
        for ip in self._fw_ips():
            try:
                if ipaddress.ip_address(ip) in n:
                    return True
            except ValueError:
                pass
        return False

    def _refs(self, rule, elname):
        el = rule.find(NS + elname)
        if el is None:
            return []
        return [r.get('ref') for r in el.iter(NS + 'ObjectRef')] + \
               [r.get('ref') for r in el.iter(NS + 'ServiceRef')]

    def _is_any(self, rule, elname):
        for ref in self._refs(rule, elname):
            o = self._obj(ref)
            if o is None or o.get('name') != 'Any':
                return False
        return True

    def _negated(self, rule, elname):
        el = rule.find(NS + elname)
        return el is not None and el.get('neg') == 'True'

    # ---------- address / service resolution ----------

    def _resolve_addr(self, ref):
        """Return list of (kind, value) for a src/dst ref.
        kind: host, network, literal, hostgroup, networkgroup."""
        o = self._obj(ref)
        if o is None:
            self.warnings.append('missing object %s' % ref)
            return []
        tag = o.tag.split('}')[1]
        name = o.get('name')
        if tag == 'AnyNetwork':
            return []
        if tag == 'Host':
            ips = self._host_ips(o)
            if not ips:
                self.warnings.append('host %s has no addresses' % name)
                return []
            self.host_ips[name] = ips
            self.db['hosts'][name] = ' '.join(ips)
            return [('host', name)]
        if tag in ('Network', 'NetworkIPv6'):
            self.db['networks'][name] = cidr(o.get('address'), o.get('netmask'))
            return [('network', name)]
        if tag in ('IPv4', 'IPv6'):
            return [('literal', o.get('address'))]
        if tag == 'ObjectGroup':
            members = [r.get('ref') for r in o.iter(NS + 'ObjectRef')]
            kinds = set()
            for m in members:
                for k, _ in self._resolve_addr(m):
                    kinds.add(k)
            if kinds <= {'host'}:
                self.db['hostgroups'][name] = ','.join(self._name(m) for m in members)
                return [('hostgroup', name)]
            if kinds <= {'network'}:
                self.db['networkgroups'][name] = ','.join(self._name(m) for m in members)
                return [('networkgroup', name)]
            res = []
            for m in members:
                res.extend(self._resolve_addr(m))
            return res
        if tag == 'Firewall':
            return [('literal', ip) for ip in self._fw_ips()]
        if tag == 'Interface':
            # a reference to a firewall interface means the network(s) it
            # serves (the subnets on it), not just the firewall's own address
            ips = self.fw_ifaces.get(name, [])
            if not ips:
                self.warnings.append('interface %s has no addresses' % name)
                return []
            nets = [cidr(ip, mask) for ip, mask in ips]
            self.db['networks'][name] = ' '.join(nets)
            return [('network', name)]
        self.warnings.append('unhandled address object %s %s' % (tag, name))
        return []

    def _resolve_addrs(self, rule, elname):
        res = []
        for ref in self._refs(rule, elname):
            res.extend(self._resolve_addr(ref))
        return res

    def _port_range(self, o):
        """Return a service's port as 'start' or 'start:end' (a range)."""
        start = o.get('dst_range_start')
        end = o.get('dst_range_end')
        if end and end != start:
            return '%s:%s' % (start, end)
        return start

    def _resolve_service(self, ref):
        """Return list of (kind, ...) for a service ref.
        kind: port (proto, port, name) or icmp (type, name)."""
        o = self._obj(ref)
        if o is None:
            self.warnings.append('missing object %s' % ref)
            return []
        tag = o.tag.split('}')[1]
        name = o.get('name')
        if tag == 'AnyIPService':
            return []
        if tag == 'TCPService':
            self.svc.add_port(name, 'tcp', self._port_range(o))
            return [('port', 'tcp', self._port_range(o), name)]
        if tag == 'UDPService':
            self.svc.add_port(name, 'udp', self._port_range(o))
            return [('port', 'udp', self._port_range(o), name)]
        if tag in ('ICMPService', 'ICMP6Service'):
            self.svc.add_icmp(name, o.get('type'))
            return [('icmp', o.get('type'), name)]
        if tag == 'ObjectGroup':
            res = []
            for m in [r.get('ref') for r in o.iter(NS + 'ServiceRef')]:
                res.extend(self._resolve_service(m))
            return res
        self.warnings.append('unhandled service object %s %s' % (tag, name))
        return []

    def _resolve_services(self, rule, elname):
        res = []
        for ref in self._refs(rule, elname):
            res.extend(self._resolve_service(ref))
        return res

    # ---------- rule generation ----------

    def _net_cidr(self, name):
        return self.db['networks'].get(name)

    def _addr_is_internal(self, kind, value):
        """True if the address is behind the firewall (LAN side)."""
        if kind == 'literal':
            return self._ip_in_lan(value) and not self._is_fw_ip(value)
        if kind == 'host':
            return any(self._ip_in_lan(ip) and not self._is_fw_ip(ip)
                       for ip in self.host_ips.get(value, []))
        if kind == 'network':
            net = self._net_cidr(value)
            return bool(net) and self._net_in_lan(net)
        # hostgroup/networkgroup: assume LAN side (conservative)
        return True

    def _addr_is_fw(self, kind, value):
        if kind == 'literal':
            return self._is_fw_ip(value)
        if kind == 'network':
            net = self._net_cidr(value)
            return bool(net) and self._net_has_fw_ip(net)
        return False

    def _chains(self, direction, srcs, dsts):
        dst_fw = any(self._addr_is_fw(k, v) for k, v in dsts)
        dst_int = any(self._addr_is_internal(k, v) for k, v in dsts)
        src_fw = any(self._addr_is_fw(k, v) for k, v in srcs)
        src_int = any(self._addr_is_internal(k, v) for k, v in srcs)
        # a network that overlaps a LAN subnet (even if it also contains a
        # firewall address) carries LAN traffic
        src_lan_net = any(k == 'network' and self._net_in_lan(self._net_cidr(v))
                          for k, v in srcs)
        if direction == 'Inbound':
            # a LAN subnet (even one that contains the firewall's own address)
            # is forwarded traffic, not traffic to the firewall itself
            if dst_int:
                return ['FORWARD']
            return ['INPUT']
        if direction == 'Outbound':
            if src_int or src_lan_net:
                return ['FORWARD', 'OUTPUT']
            return ['OUTPUT']
        if direction == 'Forward':
            return ['FORWARD']
        # Both: all chains
        return ['INPUT', 'OUTPUT', 'FORWARD']

    def _iface_for_group(self, group):
        for itf in self.fw_ifaces:
            if group.lower() == itf.lower():
                return itf
        # near match: the group name looks like an interface but doesn't match
        # exactly, so the -i/-o restriction would be silently lost
        gl = group.lower()
        for itf in self.fw_ifaces:
            il = itf.lower()
            if (gl.startswith(il) or il.startswith(gl)
                    or gl.endswith(il) or il.endswith(gl)) \
                    and min(len(gl), len(il)) >= 3 \
                    and group not in self._warned_groups:
                self._warned_groups.add(group)
                self.warnings.append(
                    "group '%s' is close to interface '%s' but does not match; "
                    "the -i/-o restriction is not applied" % (group, itf))
        return None

    def _addr_match(self, kind, value, side, neg):
        bang = '! ' if neg else ''
        if kind == 'host':
            return '%s-%s host(%s)' % (bang, side, value)
        if kind == 'network':
            return '%s-%s network(%s)' % (bang, side, value)
        if kind == 'literal':
            return '%s-%s %s' % (bang, side, value)
        if kind in ('hostgroup', 'networkgroup'):
            # the set match takes src/dst (not s/d) as its direction flag
            flag = 'src' if side == 's' else 'dst'
            return '%s(%s) %s%s' % (kind, value, '!' if neg else '', flag)
        return ''

    def _service_variants(self, srvs):
        """Return a list of service-match groups; one group per rule line.
        Services of the same proto are combined (multiport), mixed protos
        produce one group per proto."""
        byproto = {}
        icmps = []
        for s in srvs:
            if s[0] == 'port':
                _, proto, port, name = s
                byproto.setdefault(proto, []).append(
                    (self.svc.dbname[(name, proto)], port))
            else:
                _, typ, name = s
                icmps.append(name)
        variants = []
        for proto, svcs in byproto.items():
            # chunk into <=15 ports (the manifest's multiport limit); each
            # chunk becomes its own rule line (OR semantics preserved)
            for i in range(0, len(svcs), 15):
                chunk = svcs[i:i + 15]
                if len(chunk) == 1:
                    variants.append(['dservice(%s)' % chunk[0][0]])
                else:
                    variants.append(['dservices(%s)' % ','.join(s[0] for s in chunk)])
        if icmps:
            variants.append(['dservice(%s)' % n for n in icmps])
        return variants or [[]]

    def _gen_policy(self):
        for pol in self.fw.iter(NS + 'Policy'):
            pname = pol.get('name') or ''
            pl = pname.lower()
            # IPv6 policy detection: fwbuilder names it e.g. "Policy IPv6"
            # or "Policy6"; anything else is treated as IPv4
            if 'ipv6' in pl or 'v6' in pl or pl.rstrip().endswith('6'):
                table = 'filter6'
            else:
                table = 'filter'
            for rule in pol.iter(NS + 'PolicyRule'):
                if rule.get('disabled') == 'True':
                    continue
                group = rule.get('group') or 'rules'
                action = rule.get('action')
                direction = rule.get('direction')
                log = rule.get('log') == 'True'
                # final deny-all rule -> policy=drop + log global
                if (action == 'Deny' and self._is_any(rule, 'Src')
                        and self._is_any(rule, 'Dst') and self._is_any(rule, 'Srv')):
                    if log:
                        self.log_global = True
                    continue
                # loopback rules are converted as normal rules (with -i/-o lo)
                # and the implicit loopback global is disabled
                is_loopback = group.lower() == 'loopback'
                if is_loopback:
                    self.loopback_rules = True
                    iface = 'lo'
                else:
                    iface = self._iface_for_group(group)
                if direction == 'Both' and group not in self._warned_both:
                    self._warned_both.add(group)
                    self.warnings.append(
                        "rule in group '%s' has direction 'Both'; emitted in "
                        "INPUT, OUTPUT and FORWARD (review)" % group)
                srcs = self._resolve_addrs(rule, 'Src')
                dsts = self._resolve_addrs(rule, 'Dst')
                srvs = self._resolve_services(rule, 'Srv')
                chains = self._chains(direction, srcs, dsts)
                neg_src = self._negated(rule, 'Src')
                neg_dst = self._negated(rule, 'Dst')
                # reject(reset) is only valid for TCP; use unreachable otherwise
                reject_type = ('reset' if srvs and all(
                    s[0] == 'port' and s[1] == 'tcp' for s in srvs)
                    else 'unreachable')
                for chain in chains:
                    for variant in self._service_variants(srvs):
                        parts = ['-A %s' % chain]
                        if iface:
                            if chain == 'OUTPUT':
                                parts.append('-o %s' % iface)
                            else:
                                parts.append('-i %s' % iface)
                        for kind, value in srcs:
                            parts.append(self._addr_match(kind, value, 's', neg_src))
                        for kind, value in dsts:
                            parts.append(self._addr_match(kind, value, 'd', neg_dst))
                        parts.extend(variant)
                        if action == 'Accept':
                            parts.append('-j ACCEPT')
                        elif action == 'Deny':
                            parts.append('-j DROP')
                        elif action == 'Reject':
                            parts.append('reject(%s)' % reject_type)
                        if log:
                            parts.append('log(%s)' % group)
                        self.rules.append((table, ' '.join(parts), group))
                        # interface rules on FORWARD apply in both directions
                        if iface and chain == 'FORWARD':
                            fwd = ' '.join(parts).replace('-i %s' % iface, '-o %s' % iface)
                            self.rules.append((table, fwd, group))

    def _nat_service_match(self, srvs):
        """Return list of match strings, one per proto (mixed protos split)."""
        byproto = {}
        for s in srvs:
            if s[0] == 'port':
                _, proto, port, name = s
                byproto.setdefault(proto, []).append(port)
        out = []
        for proto, ports in byproto.items():
            if len(ports) == 1:
                out.append('-p %s --dport %s' % (proto, ports[0]))
            else:
                out.append('-p %s -m multiport --dports %s' % (proto, ','.join(ports)))
        return out

    def _nat_target(self, tdst, tsrv, osrv):
        """Resolve the DNAT --to-destination value (ip[:port])."""
        if not tdst:
            return ''
        kind, value = tdst[0]
        if kind == 'host':
            dst = self.host_ips.get(value, [None])[0] or value
        elif kind == 'literal':
            dst = value
        elif kind == 'network':
            net = self._net_cidr(value)
            if net:
                try:
                    dst = str(ipaddress.ip_network(net.split()[0], strict=False)
                              .network_address)
                except ValueError:
                    dst = value
            else:
                dst = value
            self.warnings.append(
                'DNAT target is a network (%s); using its first address %s'
                % (value, dst))
        else:
            self.warnings.append(
                'DNAT target is a group (%s); using its name as the address '
                '(review)' % value)
            dst = value
        tport = None
        for s in tsrv:
            if s[0] == 'port':
                tport = s[2]
        if tport and ':' not in tport:
            oport = None
            for s in osrv:
                if s[0] == 'port':
                    oport = s[2]
            if oport and ':' not in oport and tport != oport:
                dst = '%s:%s' % (dst, tport)
        return dst

    def _nat_snat_target(self, tsrc):
        """Resolve a SNAT translate-to (TSrc) to an IP, or None."""
        for kind, value in tsrc:
            if kind == 'host':
                return self.host_ips.get(value, [None])[0] or value
            if kind == 'literal':
                return value
            if kind == 'network':
                net = self._net_cidr(value)
                if net:
                    try:
                        return str(ipaddress.ip_network(net.split()[0], strict=False)
                                   .network_address)
                    except ValueError:
                        pass
        return None

    def _nat_dnat_dest(self, odst, wan):
        """The public destination IP for a DNAT rule: the rule's own public
        literal destination if present, else the firewall's first public IP."""
        for kind, value in odst:
            if kind == 'literal':
                try:
                    if not ipaddress.ip_address(value).is_private:
                        return value
                except ValueError:
                    pass
        return wan

    def _nat_snat_source(self, odst, wan, lan):
        # traffic to a private/LAN destination is SNAT'd to the LAN address,
        # everything else to the public address
        for kind, value in odst:
            if kind == 'literal' and self._ip_in_lan(value):
                return lan or wan
            if kind in ('network', 'host', 'hostgroup', 'networkgroup'):
                return lan or wan
        return wan or lan

    def _gen_nat(self):
        wan = self._fw_public_ip()
        lan = self._fw_private_ip()
        for nat in self.fw.iter(NS + 'NAT'):
            for rule in nat.iter(NS + 'NATRule'):
                if rule.get('disabled') == 'True':
                    continue
                group = rule.get('group') or 'nat'
                osrc = self._resolve_addrs(rule, 'OSrc')
                odst = self._resolve_addrs(rule, 'ODst')
                osrv = self._resolve_services(rule, 'OSrv')
                tsrc = self._resolve_addrs(rule, 'TSrc')
                tdst = self._resolve_addrs(rule, 'TDst')
                tsrv = self._resolve_services(rule, 'TSrv')
                if tdst:
                    # DNAT: use the rule's own public destination IP if given
                    dst_ip = self._nat_dnat_dest(odst, wan)
                    for sm in self._nat_service_match(osrv) or ['']:
                        parts = ['-A PREROUTING']
                        if dst_ip:
                            parts.append('-d %s' % dst_ip)
                        for kind, value in osrc:
                            parts.append(self._addr_match(kind, value, 's', False))
                        if sm:
                            parts.append(sm)
                        parts.append('-j DNAT --to-destination %s' % self._nat_target(tdst, tsrv, osrv))
                        self.nat.append(('nat', ' '.join(parts), group))
                    # hairpin SNAT (only when the source is restricted)
                    if osrc:
                        for sm in self._nat_service_match(osrv) or ['']:
                            parts = ['-A POSTROUTING']
                            for kind, value in osrc:
                                parts.append(self._addr_match(kind, value, 's', False))
                            for kind, value in tdst:
                                parts.append(self._addr_match(kind, value, 'd', False))
                            if sm:
                                parts.append(sm)
                            if lan:
                                parts.append('-j SNAT --to-source %s' % lan)
                            self.nat.append(('nat', ' '.join(parts), group))
                else:
                    # SNAT: prefer the fwbuilder translate-to (TSrc) address
                    tsrc_ip = self._nat_snat_target(tsrc)
                    src = tsrc_ip or self._nat_snat_source(odst, wan, lan)
                    if tsrc and not tsrc_ip:
                        self.warnings.append(
                            'SNAT rule in group %s: could not resolve the '
                            'translate-to address; using %s' % (group, src))
                    for sm in self._nat_service_match(osrv) or ['']:
                        parts = ['-A POSTROUTING']
                        for kind, value in osrc:
                            parts.append(self._addr_match(kind, value, 's', False))
                        for kind, value in odst:
                            parts.append(self._addr_match(kind, value, 'd', False))
                        if sm:
                            parts.append(sm)
                        parts.append('-j SNAT --to-source %s' % src)
                        self.nat.append(('nat', ' '.join(parts), group))

    # ---------- output ----------

    def run(self):
        # first pass: collect all services so tcp/udp name collisions can be
        # resolved before rules are generated
        for pol in self.fw.iter(NS + 'Policy'):
            for rule in pol.iter(NS + 'PolicyRule'):
                if rule.get('disabled') != 'True':
                    self._resolve_services(rule, 'Srv')
        for nat in self.fw.iter(NS + 'NAT'):
            for rule in nat.iter(NS + 'NATRule'):
                if rule.get('disabled') != 'True':
                    self._resolve_services(rule, 'OSrv')
                    self._resolve_services(rule, 'TSrv')
        # mangle rules are not converted; surface them so they are not silently
        # dropped
        for mangle in self.fw.iter(NS + 'Mangle'):
            n = len(list(mangle.iter(NS + 'MangleRule')))
            if n:
                self.warnings.append(
                    'firewall has %d mangle rule(s); mangle is not converted '
                    '(review manually)' % n)
                break
        self.svc.finalize()
        self._gen_policy()
        self._gen_nat()
        self.db['services'] = self.svc.db()
        return self._render()

    def _render(self):
        out = ['[global]', 'policy=%s' % self.policy,
               'established=%s' % ('true' if self.established else 'false'),
               'proto=%s' % self.proto]
        if self.loopback_rules:
            out.append('loopback=false')
        if self.icmp is not None:
            out.append('icmp=%s' % self.icmp)
        if self.log_global:
            out.append('log=Unmatched traffic')
        allrules = self.rules + self.nat
        sections = []
        for _, _, section in allrules:
            if section not in sections:
                sections.append(section)
        seen = set()
        for section in sections:
            # the manifest normalizes spaces to underscores, so two groups
            # that differ only by a space can collide into one section
            norm = section.replace(' ', '_')
            if norm in seen:
                self.warnings.append(
                    'section/group name "%s" collides with another after the '
                    'manifest normalizes spaces to underscores; the manifest '
                    'will error (Section redefined)' % section)
            seen.add(norm)
        for section in sections:
            out.append('')
            out.append('[%s]' % section)
            for table, line, sec in allrules:
                if sec == section:
                    out.append('%s=%s' % (table, line))
        return '\n'.join(out) + '\n'

    def render_db(self):
        out = []
        for section in ('services', 'hosts', 'networks',
                        'hostgroups', 'networkgroups', 'servicegroups'):
            if not self.db[section]:
                continue
            out.append('[%s]' % section)
            for name, value in sorted(self.db[section].items()):
                out.append('%s=%s' % (name, value))
            out.append('')
        return '\n'.join(out)


# ---------------------------------------------------------------------------
# Reconciliation against an existing shared db
# ---------------------------------------------------------------------------

# section -> the leaf section a group's members reference
GROUP_LEAF = {'servicegroups': 'services', 'hostgroups': 'hosts',
              'networkgroups': 'networks'}
LEAF_SECTIONS = ('services', 'hosts', 'networks')
ALL_SECTIONS = ('services', 'hosts', 'networks',
                'servicegroups', 'hostgroups', 'networkgroups')

# function name in rule text -> db section it refers to
FUNC_SECTION = {
    'host': 'hosts', 'hosts': 'hosts', 'hostgroup': 'hostgroups',
    'network': 'networks', 'networkgroup': 'networkgroups',
    'dservice': 'services', 'service': 'services',
}
FUNCRE = re.compile(r'(\w+)\(([^)]*)\)')


def parse_db_file(path):
    """Parse a shared db file into {section: {name: value}}.
    `@command` values are kept as-is (matched opaquely)."""
    out = {}
    section = None
    with open(path) as fh:
        for raw in fh:
            stripped = raw.strip()
            if not stripped or stripped.startswith('#'):
                continue
            if stripped.startswith('[') and stripped.endswith(']'):
                section = stripped[1:-1].strip()
                out.setdefault(section, {})
                continue
            if '=' in stripped and section is not None:
                key, val = stripped.split('=', 1)
                out[section][key.strip()] = val.strip()
    return out


def value_sig(section, value):
    """Normalize a db value for equality matching. Host/network IP lists and
    group member lists are order-insensitive; services compare as-is."""
    if section in ('hosts', 'networks'):
        return frozenset(value.split())
    if section in ('servicegroups', 'hostgroups', 'networkgroups'):
        return frozenset(value.split(','))
    return value


def _ask(prompt, options, default, batch):
    """Interactive single-choice prompt; auto-returns default in batch/non-tty.
    options: list of (key, label)."""
    if batch or not sys.stdin.isatty():
        return default
    while True:
        sys.stderr.write(prompt + '\n')
        for k, label in options:
            sys.stderr.write('  [%s] %s\n' % (k, label))
        try:
            choice = input('  choice [%s]: ' % default).strip().lower() or default
        except (EOFError, KeyboardInterrupt):
            return default
        if choice in [k for k, _ in options]:
            return choice


def _ask_new_name(section, old, batch):
    if batch:
        return None
    while True:
        try:
            n = input('  new name for [%s] %s (blank to skip): ' % (section, old)).strip()
        except (EOFError, KeyboardInterrupt):
            return None
        return n or None


def _resolve_conflict(section, name, gv, ev, batch):
    options = [
        ('e', 'keep existing (rules use the existing value; generated dropped)'),
        ('n', 'add generated as a new entry (choose a new name)'),
        ('s', 'skip (leave the generated entry out entirely)'),
    ]
    c = _ask("[%s] '%s' already exists as '%s', but the project has '%s'"
             % (section, name, ev, gv), options, 'e', batch)
    if c == 'e':
        return 'keep', None
    if c == 's':
        return 'skip', None
    return 'new', _ask_new_name(section, name, batch)


def _resolve_multiple(section, name, gv, matches, batch):
    options = [('%d' % (i + 1), 'map to existing %s' % m)
               for i, m in enumerate(matches)]
    options += [('n', 'add as a new entry (keep the generated name)'),
                ('s', 'skip')]
    c = _ask("[%s] '%s' (%s) matches %d existing entries: %s"
             % (section, name, gv, len(matches), ', '.join(matches)),
             options, '1', batch)
    if c == 'n':
        return 'new', None
    if c == 's':
        return 'skip', None
    return 'map', matches[int(c) - 1]


def _reconcile_section(sec, generated, existing, mapping, merge_add, report, batch):
    ex = existing.get(sec, {})
    leaf = GROUP_LEAF.get(sec)  # None for leaves
    for name, value in generated.get(sec, {}).items():
        members = value.split(',')
        eff = [mapping.get((leaf, m), m) for m in members] if leaf else members
        eff_value = ','.join(eff)
        sig = value_sig(sec, eff_value)
        if name in ex and (ex[name].startswith('@')
                           or value_sig(sec, ex[name]) != sig):
            decision, newname = _resolve_conflict(sec, name, eff_value, ex[name], batch)
            if decision == 'keep':
                report.append("[%s] %s: kept existing '%s'" % (sec, name, ex[name]))
            elif decision == 'new' and newname:
                mapping[(sec, name)] = newname
                merge_add[(sec, newname)] = eff_value
                report.append("[%s] %s: added as new '%s'" % (sec, name, newname))
            else:
                report.append("[%s] %s: skipped" % (sec, name))
        elif name in ex:
            report.append("[%s] %s: exact match, reused" % (sec, name))
        else:
            matches = [en for en, ev in ex.items()
                       if not ev.startswith('@') and value_sig(sec, ev) == sig]
            if not matches:
                merge_add[(sec, name)] = eff_value
                report.append("[%s] %s: new entry to merge" % (sec, name))
            elif len(matches) == 1:
                mapping[(sec, name)] = matches[0]
                report.append("[%s] %s -> existing %s" % (sec, name, matches[0]))
            else:
                decision, mapped = _resolve_multiple(sec, name, eff_value, matches, batch)
                if decision == 'map':
                    mapping[(sec, name)] = mapped
                    report.append("[%s] %s -> existing %s" % (sec, name, mapped))
                elif decision == 'new':
                    merge_add[(sec, name)] = eff_value
                    report.append("[%s] %s: added as new" % (sec, name))
                else:
                    report.append("[%s] %s: skipped" % (sec, name))


def reconcile(generated, existing, batch=False):
    """Diff the generated db against the shared db, resolving a name mapping
    and the set of entries to merge. Returns (mapping, merge_add, report).
    mapping: {(section, old_name): new_name}; merge_add: {(section, name): value}."""
    mapping = {}
    merge_add = {}
    report = []
    for sec in LEAF_SECTIONS:
        _reconcile_section(sec, generated, existing, mapping, merge_add, report, batch)
    for sec in ('servicegroups', 'hostgroups', 'networkgroups'):
        _reconcile_section(sec, generated, existing, mapping, merge_add, report, batch)
    return mapping, merge_add, report


# ---------------------------------------------------------------------------
# Rewriting rules + group values to the mapped names
# ---------------------------------------------------------------------------

def rewrite_rule_text(text, mapping):
    """Rewrite db-name references in rule text to their mapped names."""
    if not mapping:
        return text

    def repl(m):
        fn, args = m.group(1), m.group(2)
        if fn == 'dservices':
            if ('servicegroups', args) in mapping:
                return 'dservices(%s)' % mapping[('servicegroups', args)]
            return 'dservices(%s)' % ','.join(
                mapping.get(('services', s), s) for s in args.split(','))
        sec = FUNC_SECTION.get(fn)
        if sec is None:
            return m.group(0)
        if fn == 'hosts':
            return 'hosts(%s)' % ','.join(
                mapping.get(('hosts', h), h) for h in args.split(','))
        return '%s(%s)' % (fn, mapping.get((sec, args), args))

    return FUNCRE.sub(repl, text)


def rewrite_rules_text(text, mapping):
    """Rewrite only the rule lines of a rendered rules file."""
    if not mapping:
        return text
    out = []
    for line in text.splitlines():
        if re.match(r'^(filter|nat|mangle)\d*=([^=]|\S)', line):
            key, val = line.split('=', 1)
            out.append('%s=%s' % (key, rewrite_rule_text(val, mapping)))
        else:
            out.append(line)
    return '\n'.join(out) + '\n'


def render_merge(merge_add):
    """Render the entries to merge into a db fragment."""
    out = []
    for section in ALL_SECTIONS:
        items = {k: v for (s, k), v in merge_add.items() if s == section}
        if not items:
            continue
        out.append('[%s]' % section)
        for k in sorted(items):
            out.append('%s=%s' % (k, items[k]))
        out.append('')
    return '\n'.join(out)


def apply_db(existing_path, merge_add, backup=True):
    """Append the merge entries into the shared db under their sections.
    Existing sections get the entries appended; missing sections are created.
    Writes a .bak copy first."""
    if backup:
        shutil.copy(existing_path, existing_path + '.bak')
    sections = {s: {k: v for (sec, k), v in merge_add.items() if sec == s}
                for s in ALL_SECTIONS}
    pending = {s: sorted(names) for s, names in sections.items() if names}
    emitted = set()
    out = []
    section = None
    with open(existing_path) as fh:
        for raw in fh:
            line = raw.rstrip('\n')
            out.append(line)
            stripped = line.strip()
            if stripped.startswith('[') and stripped.endswith(']'):
                section = stripped[1:-1].strip()
                if section in pending:
                    for k in pending[section]:
                        out.append('%s=%s' % (k, sections[section][k]))
                    emitted.add(section)
    for s in ALL_SECTIONS:
        if s in pending and s not in emitted:
            out.append('')
            out.append('[%s]' % s)
            for k in pending[s]:
                out.append('%s=%s' % (k, sections[s][k]))
    with open(existing_path, 'w') as fh:
        fh.write('\n'.join(out) + '\n')



def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--fwb', required=True, help='fwbuilder project file (XML)')
    ap.add_argument('--firewall', required=True, help='firewall name in the project')
    ap.add_argument('--outdir', default='.', help='output directory')
    ap.add_argument('--output-name', help='base name for output files (default: firewall name)')
    ap.add_argument('--existing-db', help='shared db to reconcile generated entries against')
    ap.add_argument('--apply-db', action='store_true',
                    help='append the new entries into --existing-db (backup first)')
    ap.add_argument('--batch', action='store_true',
                    help='non-interactive: auto-accept defaults for ambiguous entries')
    ap.add_argument('--policy', choices=('accept', 'drop'), default='drop',
                    help='default policy for the generated ruleset (default: drop)')
    ap.add_argument('--proto', default='4,6',
                    help='IP versions to generate rules for: 4, 6 or 4,6 (default: 4,6)')
    ap.add_argument('--established', choices=('true', 'false'), default='true',
                    help='allow related/established traffic (default: true)')
    ap.add_argument('--icmp', choices=('true', 'false'),
                    help='allow icmp at the bottom of the ruleset (default: rely on explicit rules)')
    args = ap.parse_args()

    existing_db = None
    if args.existing_db:
        existing_db = parse_db_file(args.existing_db)

    conv = Converter(args.fwb, args.firewall, policy=args.policy,
                     proto=args.proto, established=(args.established == 'true'),
                     icmp=args.icmp)
    rules = conv.run()
    db = conv.render_db()
    base = args.output_name or args.firewall

    mapping = {}
    merge_add = {}
    if existing_db is not None:
        mapping, merge_add, report = reconcile(conv.db, existing_db,
                                               batch=args.batch)
        rules = rewrite_rules_text(rules, mapping)

    rules_path = '%s/%s.rules' % (args.outdir, base)
    with open(rules_path, 'w') as f:
        f.write(rules)

    if existing_db is not None:
        newdb_path = '%s/%s.new.db' % (args.outdir, base)
        newdb = render_merge(merge_add)
        with open(newdb_path, 'w') as f:
            f.write(newdb)
        print('\nReconciliation report:')
        for r in report:
            print('  ' + r)
        if merge_add:
            print('wrote %s (%d new entries)' % (newdb_path, len(merge_add)))
        else:
            print('nothing new to merge (all generated entries already in %s)'
                  % args.existing_db)
        if args.apply_db:
            if merge_add:
                apply_db(args.existing_db, merge_add)
                print('appended new entries to %s (backup at %s.bak)'
                      % (args.existing_db, args.existing_db))
            else:
                print('no changes applied to %s' % args.existing_db)
        print('wrote %s (names mapped to the shared db)' % rules_path)
    else:
        db_path = '%s/%s.db' % (args.outdir, base)
        with open(db_path, 'w') as f:
            f.write(db)
        print('wrote %s and %s' % (rules_path, db_path))

    for w in conv.warnings:
        print('warning: %s' % w, file=sys.stderr)


if __name__ == '__main__':
    main()
